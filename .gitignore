celery_results.sqlite
celerybeat-schedule
celerydb.sqlite
celerybeat.pid
geckodriver.log
ghostdriver.log
testCSV.csv
.terser-plugin-cache/
zobi-*.tar.gz*
release.json

# Translation-related files
# these json files are generated by ./scripts/po2json.sh
zobi/translations/**/messages.json
# these mo binary files are generated by `pybabel compile`
zobi/translations/**/messages.mo

docker/requirements-local.txt

cache/
docker/*local*
docker/websocket/config.json
docker-compose.override.yml

# Production secrets. docker/.env-prod.example is the tracked template; the
# filled-in copy holds ZOBI_SECRET_KEY and database passwords and must never
# be committed.
docker/.env-prod

# docker/.env holds development placeholders only and is required:true by
# docker-compose.yml, so a fresh clone cannot start the dev stack without it.
# The broad `.env` rule above would otherwise exclude it.
!docker/.env

.temp_cache

# Jest test report
test-report.html
zobi/static/stats/statistics.html

