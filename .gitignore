# Node.js, webpack artifacts, storybook
*.entry.js
*.js.map
node_modules
npm-debug.log*
zobi/static/*
# Re-include parents step by step; git cannot re-include a file whose
# parent directory is excluded, so each level must be unexcluded in turn.
!zobi/static/assets
zobi/static/assets/*
!zobi/static/assets/.gitkeep
# Source images (logos, favicon) are checked in; only build output is ignored
!zobi/static/assets/images/
!zobi/static/assets/images/**
# The blanket negation above also re-includes macOS cruft, which the top-level
# .DS_Store rule can no longer catch (last matching pattern wins).
zobi/static/assets/images/**/.DS_Store
zobi/static/assets/images/.DS_Store
zobi/static/uploads/*
!zobi/static/uploads/.gitkeep
yarn-error.log
*.map
*.min.js
test-changelog.md
*.tsbuildinfo

# Ignore package-lock in packages
plugins/*/package-lock.json
packages/*/package-lock.json

# For country map geojson conversion script
.ipynb_checkpoints/
scripts/*.zip

# IntelliJ
*.iml
venv
.venv
@eaDir/

