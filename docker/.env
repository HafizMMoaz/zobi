# Zobi Docker Environment Configuration

# Database (Postgres)
DATABASE_DIALECT=postgresql+psycopg2
DATABASE_USER=zobi
DATABASE_PASSWORD=zobi
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=zobi
POSTGRES_USER=zobi
POSTGRES_PASSWORD=zobi
POSTGRES_DB=zobi

# Examples database
EXAMPLES_USER=zobi_examples
EXAMPLES_PASSWORD=zobi_examples
EXAMPLES_HOST=db
EXAMPLES_PORT=5432
EXAMPLES_DB=zobi_examples

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CELERY_DB=0
REDIS_RESULTS_DB=1

# Zobi settings
ZOBI_SECRET_KEY=ZOBI_SECRET_KEY_CHANGE_ME_FOR_PRODUCTION_USE
ZOBI_LOAD_EXAMPLES=yes
ZOBI_ENV=development
FLASK_DEBUG=true

# Admin user
ADMIN_PASSWORD=admin

# Build settings
ZOBI_BUILD_TARGET=dev
DEV_MODE=true
INCLUDE_CHROMIUM=false
INCLUDE_FIREFOX=false
BUILD_TRANSLATIONS=false