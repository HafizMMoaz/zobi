# -----------------------------------------------------------------------
# Template for docker/.env-prod, used by docker-compose.prod.yml.
#
#   cp docker/.env-prod.example docker/.env-prod
#
# Fill in every REQUIRED value. This file is a template and contains no real
# secrets; docker/.env-prod itself is git-ignored and must never be committed.
# -----------------------------------------------------------------------

# =========================================================================
# REQUIRED: encryption key
# =========================================================================
# Zobi encrypts every stored credential with this key: database passwords,
# encrypted_extra, OAuth tokens and LLM provider API keys.
#
# Generate one with:   openssl rand -base64 42
#
# Back it up somewhere you can restore from. If it is lost or changed,
# everything already encrypted becomes unreadable. The only migration path is
# `zobi re-encrypt-secrets --previous-secret-key <old>` run while you still
# have the old key (see zobi/cli/update.py).
#
# The stack refuses to boot if this is empty or left at a placeholder.
ZOBI_SECRET_KEY=

# =========================================================================
# REQUIRED: metadata database
# =========================================================================
DATABASE_DIALECT=postgresql+psycopg2
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=zobi
DATABASE_USER=zobi
DATABASE_PASSWORD=

# Consumed by the postgres image itself. Keep in step with the values above,
# or the app authenticates against a database that was created differently.
POSTGRES_DB=zobi
POSTGRES_USER=zobi
POSTGRES_PASSWORD=

# =========================================================================
# REQUIRED: first admin account
# =========================================================================
# Used once by zobi-init to create the `admin` user. Change the password
# through the UI afterwards; this value stays in the file either way, so
# treat it as a bootstrap credential rather than a permanent one.
ADMIN_PASSWORD=

# =========================================================================
# Redis
# =========================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# Leave empty to run Redis without auth. It is not published to the host, so
# this is defensible, but set it if anything else can reach the network.
REDIS_PASSWORD=
REDIS_CELERY_DB=0
REDIS_RESULTS_DB=1
REDIS_CACHE_DB=2

# =========================================================================
# Runtime behaviour
# =========================================================================
ZOBI_ENV=production
FLASK_DEBUG=false
# Never `yes` in production: it loads sample datasets into the metadata DB.
ZOBI_LOAD_EXAMPLES=no
ZOBI_LOG_LEVEL=INFO

# Host port for the app. Bound to 127.0.0.1 by docker-compose.prod.yml, so a
# reverse proxy on the same host reaches it and the network does not.
ZOBI_PORT=8088

# =========================================================================
# Reverse proxy and cookies
# =========================================================================
# Trust X-Forwarded-* headers. Correct behind a proxy you control; a security
# hole if anything untrusted can reach the app directly, since a client could
# then spoof its own address.
ZOBI_ENABLE_PROXY_FIX=true

# Requires real HTTPS in front. Set false only while testing over plain HTTP,
# otherwise login silently fails because the session cookie is never returned.
ZOBI_SESSION_COOKIE_SECURE=true

# Public URL used in report emails, and the internal URL the headless browser
# uses to render screenshots.
ZOBI_PUBLIC_URL=https://zobi.example.com/
ZOBI_INTERNAL_URL=http://zobi-app:8088/

# =========================================================================
# Feature flags
# =========================================================================
# Enables the LLM gateway and the Manage > AI Models settings screen.
# Provider API keys entered there are encrypted with ZOBI_SECRET_KEY.
ZOBI_FEATURE_ZOBI_AI=false
ZOBI_FEATURE_ALERT_REPORTS=true
ZOBI_FEATURE_DASHBOARD_RBAC=false
ZOBI_FEATURE_EMBEDDED_ZOBI=false
ZOBI_FEATURE_ENABLE_EXTENSIONS=false
ZOBI_FEATURE_SEMANTIC_LAYERS=false

# =========================================================================
# Alerts and reports (require SMTP and a browser in the image)
# =========================================================================
# true means notifications are logged instead of sent.
ALERT_REPORTS_DRY_RUN=false
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=zobi@example.com

# =========================================================================
# Gunicorn, consumed by docker/entrypoints/run-server.sh
# =========================================================================
# A common starting point is (2 x CPU cores) + 1, then measure.
SERVER_WORKER_AMOUNT=4
SERVER_WORKER_CLASS=gthread
SERVER_THREADS_AMOUNT=20
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=2
GUNICORN_LOGLEVEL=info
# Recycling workers bounds the damage from slow memory leaks. The jitter stops
# every worker restarting at the same moment.
WORKER_MAX_REQUESTS=1000
WORKER_MAX_REQUESTS_JITTER=100

# =========================================================================
# Database connection pool
# =========================================================================
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800

# =========================================================================
# Image build options
# =========================================================================
# Chromium is needed to render report and alert screenshots. Setting this to
# false produces a smaller image that cannot generate them.
INCLUDE_CHROMIUM=true
BUILD_TRANSLATIONS=false
